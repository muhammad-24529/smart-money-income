import { validateRequestOrigin } from "@/lib/security/csrf";
import { Temporal } from "@js-temporal/polyfill";

if (!("Temporal" in globalThis)) {
  Object.defineProperty(globalThis, "Temporal", {
    value: Temporal,
    configurable: true,
  });
}

import { NextResponse } from "next/server";
import { db, connectDB } from "@/lib/prisma";
import { getUserSession } from "@/lib/auth/user";

export const runtime = "nodejs";

export async function POST(request: Request) {
  const originError = validateRequestOrigin(request);

if (originError) {
  return originError;
} try {
    await connectDB();

    // ========================================
    // AUTHENTICATION
    // ========================================

    const sessionUserId =
      await getUserSession();

    if (!sessionUserId) {
      return NextResponse.json(
        {
          success: false,
          error: "Authentication required.",
        },
        { status: 401 }
      );
    }

    const body =
      await request.json();

    // ========================================
    // REQUEST DATA
    // ========================================

    const requestedUserId =
      typeof body.userId === "string"
        ? body.userId.trim()
        : "";

    const investmentId =
      typeof body.investmentId === "string"
        ? body.investmentId.trim()
        : "";

    // Keep compatibility with frontend,
    // but never trust client userId.
    if (
      requestedUserId &&
      requestedUserId !== sessionUserId
    ) {
      return NextResponse.json(
        {
          success: false,
          error: "Unauthorized access.",
        },
        { status: 403 }
      );
    }

    const userId =
      sessionUserId;

    // ========================================
    // VALIDATION
    // ========================================

    if (!investmentId) {
      return NextResponse.json(
        {
          success: false,
          error: "Investment ID is required.",
        },
        { status: 400 }
      );
    }

    // ========================================
    // FIND INVESTMENT
    // ========================================

    const investment =
      await db.orm.public.Investment
        .where({
          id: investmentId,
          userId,
        })
        .first();

    if (!investment) {
      return NextResponse.json(
        {
          success: false,
          error: "Investment not found.",
        },
        { status: 404 }
      );
    }

    // ========================================
    // CHECK INVESTMENT STATUS
    // ========================================

    const investmentStatus =
      String(
        investment.status || ""
      ).toUpperCase();

    if (
      investmentStatus ===
      "COMPLETED"
    ) {
      return NextResponse.json(
        {
          success: false,
          completed: true,
          error:
            "This investment has already been completed.",
        },
        { status: 400 }
      );
    }

    if (
      investmentStatus !==
      "ACTIVE"
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "This investment is not active.",
        },
        { status: 400 }
      );
    }

    // ========================================
    // PURCHASE TIME
    // ========================================

    if (!investment.startAt) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Investment purchase time is missing.",
        },
        { status: 400 }
      );
    }

    // ========================================
    // CURRENT TIME
    // ========================================

    const now =
      Temporal.Now.instant();

    /*
      First START:
      purchase time + 24 hours

      Next START:
      previous START + 24 hours
    */

    const referenceTime =
      investment.lastIncomeAt ||
      investment.startAt;

    const nextAllowedStart =
      referenceTime.add({
        hours: 24,
      });

    // ========================================
    // 24 HOURS LOCK
    // ========================================

    if (
      Temporal.Instant.compare(
        now,
        nextAllowedStart
      ) < 0
    ) {
      const remainingSeconds =
        Math.max(
          0,
          Number(
            (nextAllowedStart.epochMilliseconds - now.epochMilliseconds) / 1000
          )
        );

      return NextResponse.json(
        {
          success: false,
          locked: true,
          error:
            "START is locked. You must wait 24 hours.",
          nextStartAt:
            nextAllowedStart.toString(),
          remainingSeconds,
        },
        { status: 403 }
      );
    }

    // ========================================
    // VALIDATE DURATION
    // ========================================

    const durationDays =
      Number(
        investment.durationDays
      );

    if (
      !Number.isInteger(
        durationDays
      ) ||
      durationDays <= 0
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Invalid investment duration.",
        },
        { status: 400 }
      );
    }

    // ========================================
    // COUNT DAILY INCOME CYCLES
    // ========================================

    const dailyIncomeTransactions =
      await db.orm.public.Transaction
        .where({
          investmentId:
            investment.id,
          type:
            "DAILY_INCOME",
        })
        .all();

    const completedCycles =
      dailyIncomeTransactions.filter(
        (transaction: any) =>
          String(
            transaction.status || ""
          ).toUpperCase() ===
          "COMPLETED"
      ).length;

    // ========================================
    // ALREADY COMPLETED
    // ========================================

    if (
      completedCycles >=
      durationDays
    ) {
      await db.orm.public.Investment
        .where({
          id:
            investment.id,
          userId,
        })
        .update({
          status:
            "COMPLETED",
        });

      return NextResponse.json(
        {
          success: false,
          completed: true,
          error:
            "All daily income cycles have already been completed.",
        },
        { status: 400 }
      );
    }

    // ========================================
    // FIND AUTHENTICATED USER
    // ========================================

    const user =
      await db.orm.public.User
        .where({
          id: userId,
        })
        .first();

    if (!user) {
      return NextResponse.json(
        {
          success: false,
          error: "User not found.",
        },
        { status: 404 }
      );
    }

    // ========================================
    // ACCOUNT STATUS
    // ========================================

    if (!user.isActive) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Your account has been deactivated.",
        },
        { status: 403 }
      );
    }

    // ========================================
    // DAILY INCOME
    // ========================================

    const income =
      Number(
        investment.dailyIncome
      );

    if (
      !Number.isInteger(
        income
      ) ||
      income <= 0
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Invalid daily income amount.",
        },
        { status: 400 }
      );
    }

    // ========================================
    // CURRENT WALLET
    // ========================================

    const currentBalance =
      Number(
        user.balance || 0
      );

    if (
      !Number.isInteger(
        currentBalance
      ) ||
      currentBalance < 0
    ) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Invalid wallet balance.",
        },
        { status: 500 }
      );
    }

    const newBalance =
      currentBalance +
      income;

    // ========================================
    // CURRENT CYCLE
    // ========================================

    const currentCycle =
      completedCycles + 1;

    // ========================================
    // UPDATE WALLET
    // ========================================
    //
    // The balance condition prevents an old
    // balance from being overwritten if another
    // request changed it first.
    //

    const updatedUser =
      await db.orm.public.User
        .where({
          id: userId,
          balance:
            currentBalance,
        })
        .update({
          balance:
            newBalance,
        });

    if (!updatedUser) {
      return NextResponse.json(
        {
          success: false,
          error:
            "Wallet changed before START was processed. Please refresh and try again.",
        },
        { status: 409 }
      );
    }

    // ========================================
    // CREATE TRANSACTION
    // ========================================

    try {
      await db.orm.public.Transaction.create({
        userId,

        investmentId:
          investment.id,

        type:
          "DAILY_INCOME",

        amount:
          income,

        description:
          `Daily investment income - cycle ${currentCycle}/${durationDays}.`,

        status:
          "COMPLETED",
      });
    } catch (transactionError) {
      console.error(
        "DAILY INCOME TRANSACTION ERROR:",
        transactionError
      );

      return NextResponse.json(
        {
          success: false,
          error:
            "Income was added, but transaction recording failed. Please contact administrator.",
        },
        { status: 500 }
      );
    }

    // ========================================
    // UPDATE INVESTMENT
    // ========================================

    if (
      currentCycle >=
      durationDays
    ) {
      await db.orm.public.Investment
        .where({
          id:
            investment.id,
          userId,
        })
        .update({
          lastIncomeAt:
            now,
          status:
            "COMPLETED",
        });

      return NextResponse.json({
        success: true,
        completed: true,

        message:
          "START successful. Final daily income added. Investment completed.",

        income: {
          amount:
            income,
          cycle:
            currentCycle,
          totalCycles:
            durationDays,
        },

        wallet: {
          previousBalance:
            currentBalance,
          incomeAdded:
            income,
          newBalance:
            newBalance,
        },

        nextStartAt:
          null,
      });
    }

    // ========================================
    // KEEP INVESTMENT ACTIVE
    // ========================================

    await db.orm.public.Investment
      .where({
        id:
          investment.id,
        userId,
      })
      .update({
        lastIncomeAt:
          now,
        status:
          "ACTIVE",
      });

    // ========================================
    // NEXT START
    // ========================================

    const nextStartAt =
      now.add({
        hours: 24,
      });

    // ========================================
    // SUCCESS
    // ========================================

    return NextResponse.json({
      success: true,
      completed: false,

      message:
        "START successful. Daily income added to your wallet.",

      income: {
        amount:
          income,
        cycle:
          currentCycle,
        totalCycles:
          durationDays,
      },

      wallet: {
        previousBalance:
          currentBalance,
        incomeAdded:
          income,
        newBalance:
          newBalance,
      },

      nextStartAt:
        nextStartAt.toString(),
    });
  } catch (error) {
    console.error(
      "INVESTMENT START ERROR:",
      error
    );

    return NextResponse.json(
      {
        success: false,
        error:
          "Unable to process investment START.",
      },
      { status: 500 }
    );
  }
}


